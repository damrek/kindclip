{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kindclip",
  "version": "2.1.2",
  "identifier": "app.kindclip",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kindclip",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Kindle clippings viewer",
    "longDescription": "Importa tu My Clippings.txt de Kindle, filtra por texto y libro, y guarda favoritos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:kindclip.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3OTgyMTBGMzE0MUNGMDIKUldRQ3owRXhEeUdZcDEyMU4wNW4xckpqcllLVm9PNnhPUlBuQ3hkM1JWSkIvZDg3cmg2M3BsMzgK",
      "endpoints": [
        "https://github.com/damrek/kindclip/releases/latest/download/latest.json"
      ]
    }
  }
}
