{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kindclip",
  "version": "1.3.0",
  "identifier": "app.kindclip",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kindclip",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Kindle clippings viewer",
    "longDescription": "Importa tu My Clippings.txt de Kindle, filtra por texto y libro, y guarda favoritos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:kindclip.db"
      ]
    }
  }
}
